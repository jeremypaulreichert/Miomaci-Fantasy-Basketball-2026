{
 "@context": "https://schema.org",
 "@type": "Dataset",
 "name": "Miomaci AI Fantasy Basketball Solo Roster: openai",
 "description": "One frontier AI model building its own 13-player fantasy basketball roster alone, without competition, under the same rules, research limits and player packet as the shared draft. Records give model identity, timing, research counts, source domains, token usage, estimated cost, failures and each selected player, plus a naive per-turn baseline. Companion shared-draft and forecast files are separate datasets.",
 "license": "LICENSE_PENDING_OWNER_DECISION",
 "version": "0.1.0",
 "temporalCoverage": "2026-10-19/2027-04-11",
 "keywords": [
  "AI agents",
  "LLM evaluation",
  "fantasy basketball",
  "decision making",
  "web research",
  "forecasting",
  "NBA",
  "frontier models"
 ],
 "creator": {
  "@type": "Person",
  "name": "Jeremy Reichert"
 },
 "isAccessibleForFree": true,
 "variableMeasured": [
  "decision_id",
  "arm",
  "pick_number",
  "round",
  "manager",
  "model",
  "status",
  "player_id",
  "player_name",
  "decision_wall_ms",
  "model_calls",
  "searches",
  "reads",
  "input_tokens",
  "output_tokens",
  "estimated_charge_micro_usd",
  "usage_complete",
  "baseline_player_id",
  "baseline_minus_chosen_fppg"
 ],
 "distribution": [
  {
   "@type": "DataDownload",
   "encodingFormat": "application/jsonlines",
   "contentUrl": "calls.jsonl"
  },
  {
   "@type": "DataDownload",
   "encodingFormat": "text/csv",
   "contentUrl": "decisions.csv"
  },
  {
   "@type": "DataDownload",
   "encodingFormat": "application/jsonlines",
   "contentUrl": "decisions.jsonl"
  },
  {
   "@type": "DataDownload",
   "encodingFormat": "application/json",
   "contentUrl": "prompts.json"
  },
  {
   "@type": "DataDownload",
   "encodingFormat": "application/json",
   "contentUrl": "rules.json"
  },
  {
   "@type": "DataDownload",
   "encodingFormat": "application/json",
   "contentUrl": "timing.json"
  }
 ],
 "url": "LANDING_PAGE_URL_PENDING_OWNER",
 "identifier": "DOI_PENDING_OWNER"
}